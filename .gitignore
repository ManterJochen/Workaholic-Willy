# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtualenv
.venv/
venv/

# Tooling caches & coverage artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
.cov.json
coverage.xml
htmlcov/

# Runtime logs + generated run artifacts (soak reports, JSONL records, demo MP4s, calibration dumps)
logs/

# Isaac Sim / crash dumps
*.dmp

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Generated datasets (datagen). Large; the output path is configurable and defaults here.
data/

# Downloaded model weights (HuggingFace cache).
assets/models/hf/

# Frontend (the operator console).
frontend/node_modules/
api/static/

# Operator-downloaded MediaPipe task bundles (hand/gesture).
assets/models/mediapipe/

# The fitted grasp ranker's TREES.
assets/models/grasp_ranker/**/*.json
!assets/models/grasp_ranker/**/*.card.json

# Third-party meshes for the scene generator (GSO / YCB, CC-BY).
# Fetched with `python -m datagen.assets --fetch --from <dir> --source <source>`;
# `python -m datagen.assets --check` says whether this machine has them.
assets/meshes/

# Convex decompositions of the mesh bank (CoACD). Derived from assets/meshes/, which is
# itself fetched rather than vendored, and regenerated on demand at about 8 s per mesh.
# A cache, not a source: deleting it costs render time and nothing else.
assets/cache/

# Trained grasp-generator artifacts.
*.ckpt.pt
grasp_generator_v1.pt
logs/dl/models/
# Temporary migration commit notes. Removed with its gitignore entry once
# the migration is committed.
.commits/
